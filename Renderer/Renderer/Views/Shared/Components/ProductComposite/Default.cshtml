@using Microsoft.AspNetCore
@using Progress.Sitefinity.AspNetCore.TagHelpers;
@using Progress.Sitefinity.AspNetCore.Mvc.Rendering;
@model Renderer.ViewModels.ProductCompositeViewModel

@{
    var compositeFieldUniqueId = Model.FieldName;
    var ariaDescribedByAttribute = string.Empty;
    var compositeFieldErrorMessageId = Html.GetUniqueId("CompositeErrorMessage");

    @if (Model.HasDescription)
    {
        ariaDescribedByAttribute = $"aria-describedby='{compositeFieldUniqueId} {compositeFieldErrorMessageId}'";
    }
    else
    {
        ariaDescribedByAttribute = $"aria-describedby='{compositeFieldErrorMessageId}'";
    }
}
<script data-sf-role='start_field_@compositeFieldUniqueId' data-sf-role-field-name='@compositeFieldUniqueId'></script>
<div class="mb-3 @Model.CssClass"
     data-sf-role="composite-field-container"
     data-composite-id="@compositeFieldUniqueId"
     data-product-count="@Model.ProductInfoList.Count">

    <!-- Hidden field to store the composite JSON value -->
    <input type="hidden" id="@compositeFieldUniqueId" name="@Model.FieldName" data-sf-role="text-field-input"
           @(Model.Readonly ? "readonly" : "")
           @Html.Raw(ariaDescribedByAttribute)
           @Html.Raw(Model.ValidationAttributes) />

    <!-- Label and instructional text -->
    @if (!string.IsNullOrEmpty(Model.Label))
    {
        <label class="form-label">@Model.Label</label>
    }

    @if (Model.HasDescription)
    {
        <div class="form-text mb-2">@Model.InstructionalText</div>
    }

    <!-- Dynamic product info fields container -->
    <div id="product-info-container">
        @for (int i = 0; i < Model.ProductInfoList.Count; i++)
        {
            var productInfo = Model.ProductInfoList[i];
            var productTitleUniqueId = productInfo.ProductTitleFieldName;
            var productDescriptionUniqueId = productInfo.ProductDescriptionFieldName;
            var productTitleErrorMessageId = Html.GetUniqueId("ProductTitleErrorMessage");
            var productDescriptionErrorMessageId = Html.GetUniqueId("ProductDescriptionErrorMessage");

            <div class="product-info-item border p-3 mb-3" data-product-index="@i">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0">Product @(i + 1)</h6>
                    @if (Model.ProductInfoList.Count > 1)
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger remove-product" data-index="@i">Remove</button>
                    }
                </div>

                <div class="mb-3">
                    <label for="@productTitleUniqueId" class="form-label">@productInfo.ProductTitleLabel</label>
                    <input id="@productTitleUniqueId"
                           type="text"
                           class="form-control product-title-field"
                           data-index="@i"
                           @Html.Raw(productInfo.ProductTitleValidationAttributes)
                           aria-describedby="@productTitleErrorMessageId" />
                    <div id="@productTitleErrorMessageId" class="invalid-feedback"></div>
                </div>

                <div class="mb-3">
                    <label for="@productDescriptionUniqueId" class="form-label">@productInfo.ProductDescriptionLabel</label>
                    <textarea id="@productDescriptionUniqueId"
                          class="form-control product-description-field"
                          data-index="@i"
                          rows="3"
                          @Html.Raw(productInfo.ProductDescriptionValidationAttributes)
                          aria-describedby="@productDescriptionErrorMessageId"></textarea>
                    <div id="@productDescriptionErrorMessageId" class="invalid-feedback"></div>
                </div>
            </div>
        }

    </div>

    <!-- Add new product button -->
    <button type="button" id="add-product-btn" class="btn btn-outline-primary">
        <i class="fas fa-plus"></i> Add Another Product
    </button>

    <!-- Error message container -->
    <div id="@compositeFieldErrorMessageId" class="invalid-feedback"></div>
</div>

<script src="~/js/form-widgets/product-composite-widget.js"></script>
<script data-sf-role='end_field_@compositeFieldUniqueId'></script>
