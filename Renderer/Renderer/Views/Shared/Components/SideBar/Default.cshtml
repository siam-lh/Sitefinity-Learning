@using Renderer.ViewModels
@model WhereToBuyViewModel

<div class="vertical-tabs-wrapper">
    <!-- For PC-->
    <!-- Region Tabs -->
    <div class="left-column">
        <p>
            Distributors by Region
        </p>
       <div class="divider"></div>
        <ul class=" mb-3" id="regionTabs">
            @foreach (var region in Model.AvailableRegions)
            {
                var isActive = Model.Region == region ? "tab-active" : "";
                <li class="nav-item">
                    <a href="#" class="nav-link @isActive" data-region="@region">@region</a>
                </li>
            }
        </ul>
    </div>
    <!-- Subregion Filter and Content Area-->
    <div class="right-column">
        <div class="filter-portion">
            <!-- Subregion Filter -->
            <span>FILTER</span>
            @{
                List<string> subregionsForRegion = new List<string>();

                if (Model.Regions != null && Model.Regions.ContainsKey(Model.Region))
                {
                    subregionsForRegion = Model.Regions[Model.Region];
                }
                <select id="subRegionFilter">
                    <option value="">All </option>
                    @foreach (var sub in subregionsForRegion)
                    {
                        <option value="@sub" selected="@(sub == Model.SubRegion ? "selected" : null)">@sub</option>
                    }
                </select>
            }
 
        </div>
        <div class="content-list">
            <div class="mobile-drawer px-3 py-2">
                <div class="text-center mt-1">
                    <h3>Distributors by Region</h3>
                </div>
                <div class="py-3 mobile-drawer-breadcrumb d-flex justify-content-between align-items-end">
                    <div class="d-flex flex-column me-2">
                        <p class="mb-1 fw-bold">Region:</p>
                        <p class="mb-0 d-flex flex-wrap gap-1">
                            @foreach (var region in Model.AvailableRegions)
                            {
                                var isActive = Model.Region == region ? "d-block" : "d-none";
                                <span class="@isActive" data-region="@region">@region</span>
                            }

                            @foreach (var sub in Model.AvailableSubRegions)
                            {
                                var isActive = Model.SubRegion == sub ? "d-block" : "d-none";
                                <span class="@isActive" data-region="@sub">&nbsp;>&nbsp;@sub</span>
                            }
                        </p>
                    </div>

                    <!-- Right Side: Filter Button -->
                    <div>
                        <button id="openDrawerBtn" class="filter-btn">Filter</button>
                    </div>
                </div>
            </div>
            <!-- Content Area -->
           
            <div id="dynamicContent">
                <table class="responsive-table">
                    <thead>
                        <tr>
                            <th class="merged-header">COMPANY</th>
                            <th class="hide-on-mobile">PHONE</th>
                            <th>SEND MY LIST</th>
                            <th>WEB</th>
                        </tr>
                    </thead>
                </table>
                <div class="table-body-scroll">
                    <div id="dynamicList">
                        <partial name="_DynamicTableContent" model="Model" /> 
                         @* @await Html.PartialAsync("~/Views/Shared/Components/SideBar/_DynamicTableContent.cshtml", Model) *@
                    </div>
                    <div id="skeletonLoader">
                        <partial name="_SkeletonTableContentLoader" model="Model" />
                    </div>
                </div>

            </div>
            
        </div>
    </div>

    <!-- For mobile-->
    <!-- Overlay -->
    <div id="drawerOverlay" class="drawer-overlay"></div>

    <!-- Slide-in Drawer Panel -->
    <div id="drawerPanel" class="drawer-panel">
        <div class="drawer-contents">
            <div class="drawer-header d-flex justify-content-between align-items-center px-4 py-3 border-bottom">
                <h5 class="mb-0 fw-bold">Filter</h5>
                <button id="closeDrawerBtn" class="btn-close fw-bold text-gray"></button>
            </div>
            <div class="drawer-body h-100">
                <div class="drawer-body-list">
                    <ul id="mobileRegionTabs" class="m-0 p-0">
                        @foreach (var region in Model.AvailableRegions)
                        {
                            <li class="faq-item">
                                <div class="faq-header">
                                    <a href="#" class="nav-link faq-question" data-region="@region">@region</a>
                                    <button class="faq-toggle">+</button>
                                </div>
                                <div class="faq-answer">
                                    <ul class="mobile-subregion-tabs">
                                        @{
                                            var Regions = Model.Regions.GetValueOrDefault(region);
                                            foreach (var sub in Regions)
                                            {
                                                <li class="nav-item">
                                                    <a href="#" class="subregion-nav-link nav-link" data-region="@sub">@sub</a>
                                                </li>
                                            }
                                        }
                                    </ul>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Include External JS -->
<script src="~/js/widgets/sidebar-widget.js"></script>
