                                <svg width="1.75rem" height="1.75rem" viewBox="0 0 42 42" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20.75 0.375C16.6708 0.375 12.6831 1.58464 9.29137 3.85094C5.89961 6.11724 3.25605 9.33843 1.69499 13.1072C0.133937 16.8759 -0.274507 21.0229 0.521313 25.0237C1.31713 29.0246 3.28147 32.6996 6.16593 35.5841C9.05039 38.4685 12.7254 40.4329 16.7263 41.2287C20.7271 42.0245 24.8741 41.6161 28.6429 40.055C32.4116 38.494 35.6328 35.8504 37.8991 32.4586C40.1654 29.0669 41.375 25.0792 41.375 21C41.3688 15.5318 39.1939 10.2894 35.3273 6.42276C31.4607 2.55616 26.2182 0.381187 20.75 0.375ZM20.75 38.875C17.9106 38.875 14.9379 35.2147 13.4625 29.25H28.0375C26.5621 35.2147 23.5894 38.875 20.75 38.875ZM12.9043 26.5C12.3653 22.8531 12.3653 19.1469 12.9043 15.5H28.5958C28.8685 17.3206 29.0036 19.1591 29 21C29.0036 22.8409 28.8685 24.6794 28.5958 26.5H12.9043ZM2.87501 21C2.876 19.1321 3.17112 17.2761 3.74951 15.5H10.1433C9.61893 19.1479 9.61893 22.8521 10.1433 26.5H3.74951C3.17112 24.7239 2.876 22.8679 2.87501 21ZM20.75 3.125C23.5894 3.125 26.5621 6.78525 28.0375 12.75H13.4625C14.9379 6.78525 17.9106 3.125 20.75 3.125ZM31.3568 15.5H37.7505C38.9162 19.074 38.9162 22.926 37.7505 26.5H31.3568C31.6175 24.6782 31.7489 22.8403 31.75 21C31.7489 19.1597 31.6175 17.3218 31.3568 15.5ZM36.5914 12.75H30.8618C30.2499 9.7594 29.0501 6.9201 27.3321 4.39687C31.3171 5.9861 34.6016 8.94918 36.5914 12.75ZM14.1679 4.39687C12.4499 6.9201 11.2502 9.7594 10.6383 12.75H4.90863C6.89843 8.94918 10.1829 5.9861 14.1679 4.39687ZM4.90863 29.25H10.6383C11.2502 32.2406 12.4499 35.0799 14.1679 37.6031C10.1829 36.0139 6.89843 33.0508 4.90863 29.25ZM27.3321 37.6031C29.0501 35.0799 30.2499 32.2406 30.8618 29.25H36.5914C34.6016 33.0508 31.3171 36.0139 27.3321 37.6031Z" fill="#c8102e"></path></svg>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <!-- Overlay -->
    <div id="drawerOverlay" class="drawer-overlay"></div>

    <!-- Slide-in Drawer Panel -->
    <div id="drawerPanel" class="drawer-panel">
        <div class="drawer-contents">
            <div class="drawer-header d-flex justify-content-between align-items-center px-4 py-3 border-bottom">
                <h5 class="mb-0 fw-bold">Filter</h5>
                <button id="closeDrawerBtn" class="btn-close fw-bold text-gray"></button>
            </div>
            <div class="drawer-body h-100">
             
                <div class="drawer-body-list">
                    <ul id="mobileRegionTabs" class="m-0 p-0">
                        @foreach (var region in Model.AvailableRegions)
                        {
                            <li class="faq-item">
                                <div class="faq-header py-3 px-4">
                                    <a href="#" class="nav-link faq-question" data-region="@region">@region</a>
                                    <button class="faq-toggle">+</button>
                                </div>
                                <div class="faq-answer">
                                    <ul class="mobile-subregion-tabs">
                                        @{
                                            var Regions = Model.Regions.GetValueOrDefault(region);
                                            foreach (var sub in Regions)
                                            {
                                                <li class="nav-item">
                                                    <a href="#" class="subregion-nav-link nav-link" data-region="@sub">@sub</a>
                                                </li>
                                            }
                                        }
                                    </ul>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

</div>



